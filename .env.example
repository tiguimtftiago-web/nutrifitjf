# Mercado Pago — credencial privada do servidor
MERCADOPAGO_ACCESS_TOKEN=

# Mercado Pago — segredo gerado em Webhooks > Configurar notificações
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO.com.br

# Notificação automática de pedido pago por e-mail
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_FROM=

# Exemplo:
# NEXT_PUBLIC_SITE_URL=https://nutrifitjf.vercel.app
# ORDER_NOTIFICATION_EMAIL=seuemail@dominio.com
